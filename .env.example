# OpenAI-compatible endpoint (ProxyAPI or any OpenAI-compatible provider)
OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o-mini

# Confidence threshold below which needs_review is forced to true
CONFIDENCE_THRESHOLD=0.55

# How many snippets to retrieve per search method before merging
TOP_K=5

# SQLite database file path
DATABASE_PATH=./data/knowledge.db

# ChromaDB persistent storage path
CHROMA_PATH=./data/chroma

# Web server port
PORT=8000
